# Python
.venv/
__pycache__/
*.pyc

# Secrets — never commit tokens
.env

# DuckDB database (regenerable from ingest + backfill)
*.duckdb
*.duckdb.wal
*.duckdb.tmp/

# Generated site data — latest.json IS tracked so Cloudflare Pages (connected to
# this GitHub repo) can serve it; the dated archive stays local to avoid repo bloat.
/site/data/archive/

# Run logs (regenerable; also keeps any future log output out of git)
logs/

# Browser-automation scratch (if it ever appears)
.playwright-mcp/
