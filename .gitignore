# Python
.venv/
__pycache__/
*.pyc

# Secrets — never commit tokens
.env

# DuckDB database (regenerable from ingest + backfill)
*.duckdb
*.duckdb.wal
*.duckdb.tmp/

# Generated site data artifact
/site/data/*.json
/site/data/archive/

# Run logs (regenerable; also keeps any future log output out of git)
logs/

# Browser-automation scratch (if it ever appears)
.playwright-mcp/
