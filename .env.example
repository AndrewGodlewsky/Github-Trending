# Copy to `.env` and fill in. `.env` is gitignored — never commit real tokens.

# GitHub personal access token (Phase 3 — daily ingest sweep). Public repo read is enough.
GITHUB_TOKEN=

# Google Gemini API key (Phase 5 — summaries). From https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Failure-alert webhook (Phase 8 — Discord/Slack incoming-webhook URL). Optional. See docs/discord-webhook.md
ALERT_WEBHOOK_URL=

# Path to the seed CSV snapshots (Phase 2 backfill). Defaults to the planning workspace's data/ folder.
DATA_DIR=A:/Claude/Project Skills/data

# DuckDB database file (created on first run).
DB_PATH=github_trending.duckdb

# Publishing is handled by Cloudflare Pages connected to this GitHub repo (see
# docs/deploy.md): the daily job pushes latest.json and Cloudflare auto-deploys.
# No deploy token or project variable is needed here.
